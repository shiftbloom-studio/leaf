{
  "name": "leaf",
  "version": "1.0.0",
  "description": "A pastebin with syntax highlighting for Cloudflare Workers",
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "deploy": "npm run build:client && wrangler deploy",
    "typecheck": "npm run build:client && tsc -p .",
    "db:migrate": "wrangler d1 migrations apply leaf-db --remote",
    "build:client": "esbuild src/detect-client.ts --bundle --format=iife --minify --target=es2020 --outfile=src/generated/detect.txt",
    "build": "npm run build:client && esbuild src/index.ts --bundle --format=esm --minify --target=es2025 --loader:.png=binary --outfile=dist/index.js",
    "test": "vitest run",
    "check": "npm run build:client && tsc -p . && vitest run && npm run build"
  },
  "dependencies": {
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@types/node": "^26.6.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "wrangler": "^4.169.0"
  },
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiftbloom-studio/leaf.git"
  },
  "homepage": "https://leaf.shiftbloom.studio",
  "bugs": {
    "url": "https://github.com/shiftbloom-studio/leaf/issues"
  },
  "engines": {
    "node": ">=26"
  }
}
