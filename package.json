{
  "name": "leaf",
  "version": "0.1.0",
  "description": "A pastebin with syntax highlighting for Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p .",
    "db:migrate": "wrangler d1 migrations apply leaf-db --remote",
    "build": "esbuild src/index.ts --bundle --format=esm --minify --target=es2022 --outfile=dist/index.js",
    "test": "vitest run",
    "check": "tsc -p . && vitest run && npm run build"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^26.6.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.168.0"
  },
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiftbloom-studio/leaf.git"
  },
  "homepage": "https://leaf.shiftbloom.studio",
  "bugs": {
    "url": "https://github.com/shiftbloom-studio/leaf/issues"
  },
  "engines": {
    "node": ">=26"
  }
}
